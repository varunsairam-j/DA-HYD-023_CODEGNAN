   ],
   "source": [
    "# Example-3\n",
    "\n",
    "height = [5.2,5.4,5.6,6.2,6.4,5,6,7,\"Varun\"]\n",
    "\n",
    "Ser_3 = pd.Series(height)\n",
    "print(Ser_3)\n",
    "print(type(Ser_3))"
   ]
  },
