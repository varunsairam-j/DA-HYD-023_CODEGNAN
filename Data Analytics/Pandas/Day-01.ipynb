   "source": [
    "# In Pandas, Strings are represented as \"Objects\"\n",
    "\n",
    "#  Series of Strings\n",
    "\n",
    "Movies = [\"The Prestige\",\"Jersey\",\"K.G.F\",\"Raguvaran B.Tech\"]\n",
