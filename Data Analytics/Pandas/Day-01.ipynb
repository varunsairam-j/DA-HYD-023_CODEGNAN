    "# Data Structures creation (Series, Dataframe)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "88b85645-46e4-416f-aee7-ef055dee4ff1",
   "metadata": {},
   "source": [
    "# -> Series : 1D array"
   ]
  },
  {
   "cell_type": "raw",
   "id": "f0074a02-075a-4cf0-93ce-2723f761226a",
   "metadata": {},
   "source": [
    "Definition : Series is 1D Homogeneous array in pandas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3ea98a34-0c88-4070-b1de-62700a7d1016",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Series([], dtype: object)\n",
      "<class 'pandas.Series'>\n"
     ]
    }
   ],
   "source": [
    "# --> Creation of Series\n",
    "\n",
    "Ser_1 = pd.Series()       # To create a Series, this is a empty Series\n",
    "print(Ser_1)\n",
    "print(type(Ser_1))        # To Check data type -> type()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b52818e7-8648-49ea-b149-7392407a999d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0    30\n",
      "1    40\n",
      "2    50\n",
      "3    60\n",
      "4    70\n",
      "5    80\n",
      "dtype: int64\n",
      "<class 'pandas.Series'>\n"
     ]
    }
   ],
   "source": [
    "# Example-2 \n",
    "\n",
    "salary = [30,40,50,60,70,80]\n",
    "\n",
    "Ser_2 = pd.Series(salary)         # Converting a List into Series\n",
    "print(Ser_2)\n",
    "print(type(Ser_2))\n",
    "\n",
    "# Series Automatically add the indexing of Elements"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "30e9bbcd-a37b-4b54-92ae-d1d16455ba6d",
   "metadata": {},
   "outputs": [
